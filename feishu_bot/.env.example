FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LOG_LEVEL=INFO
FETCH_CHAT_INFO=true
MONITOR_CHAT_NAME=目标研报群名称
AISTOCK_API_URL=https://gupiao-api.yaozhineng.com
INTERNAL_TOKEN=与后端一致的内部令牌

ENABLE_OCR=true
OCR_ENGINE=paddle
OCR_WORKERS=1
OCR_MAX_IMAGE_MB=15
OCR_MAX_IMAGE_SIDE=4096
OCR_MIN_CONFIDENCE=0.45
OCR_MAX_ATTEMPTS=3
OCR_CPU_THREADS=2

DOWNLOAD_PDF=true
DOWNLOAD_IMAGE=true
DOWNLOAD_DIR=downloads
OCR_CONTAINER_CPUS=2.0
OCR_CONTAINER_MEMORY=4g

# ===== QQ/OneBot 捕获（飞书停更后主要来源） =====
# QQ_ENABLE=true 时启动 QQ 群 PDF 捕获，飞书侧不启动
QQ_ENABLE=false
ONEBOT_WS_HOST=0.0.0.0
ONEBOT_WS_PORT=8081
# 目标 QQ 群号（必填）
QQ_GROUP_ID=
# 启动时补拉最近 N 天群文件
QQ_HISTORY_DAYS=7
# 群文件轮询间隔（秒）
QQ_FILE_POLL_INTERVAL=900
# 去重状态文件路径（Docker 部署建议挂载到持久卷）
QQ_STATE_PATH=qq_processed_ids.json
